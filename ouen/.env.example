# Karbon API credentials. Both are issued together from the same API
# application in Karbon and are not interchangeable. The Authorization value is
# the application token; the AccessKey is found under Settings, Connected Apps.
KARBON_BEARER_TOKEN=
KARBON_ACCESS_KEY=

# Where the runner keeps its own store. Back this up: it is the audit trail.
OUEN_DB_PATH=./ouen-runner.db

# Shared secret used to sign webhook payloads. Set this before subscribing, so
# that every delivery can be proved to have come from Karbon. Minimum 16
# characters, letters, numbers, dashes and underscores only.
KARBON_WEBHOOK_SIGNING_KEY=

# Listener bind address. Put a TLS terminator in front of it: Karbon will only
# deliver to an HTTPS target URL.
OUEN_LISTENER_HOST=127.0.0.1
OUEN_LISTENER_PORT=8787

# Hours of webhook silence before the stall check calls the pipe dead.
OUEN_PIPE_SILENCE_HOURS=36

# Off by default. The only Karbon write this phase permits is creating or
# deleting a webhook subscription, and it needs this turned on deliberately.
KARBON_ALLOW_SUBSCRIPTION_WRITES=false
